
\ API conformance probes for forth — the same sections as lua.lua, in the
\ same order; that file is the reference and carries the protocol notes.
\
\ PROBE traces the marker, then runs the probe word.  forth's CATCH catches a
\ THROW, and what a binding refuses is not one — a pop past the empty stack
\ reads memory rather than raising — so the sections whose call the reference
\ refuses are not in this file.  Neither are the sections whose argument is a
\ string, a float, or left out: a forth word takes what the stack holds, and
\ the stack holds integers.  The coverage line is what says so.
\
\ Generated by openspec/changes/conformance-forth-probes/generate.py, whose
\ table carries each word's stack shape as src/api/forth.c comments it (the API words
\ are listed in vendor/lugforth/tic80_api.h).

: PROBE ( xt c-addr u -- )
    15 TRACE
    CATCH IF S" !error" 15 TRACE THEN
;

\ ---- cls

: P_CLS_DEFAULT
    10 10 4 PIX!
    0 CLS
    10 10 PIX DROP
;

: P_CLS_COLOR
    7 CLS
    4 4 PIX DROP
    235 131 PIX DROP
;

\ cls/wrong-type: the argument is a string or a float, and forth's words take integers

: P_CLS_OUT_OF_RANGE
    0 0 6 PIX!
    99 CLS
    0 0 PIX DROP
;


\ ---- print

: P_PRINT_WIDTH
    S" A" 5 5 15 FALSE 1 FALSE PRINT DROP
;

: P_PRINT_DEFAULTS
    S" A" 0 0 15 FALSE 1 FALSE PRINT DROP
;

: P_PRINT_SCALE
    S" A" 5 5 15 FALSE 2 FALSE PRINT DROP
;

: P_PRINT_FIXED
    S" ii" 0 0 15 TRUE 1 FALSE PRINT DROP
    S" ww" 0 10 15 TRUE 1 FALSE PRINT DROP
;

\ print/no-args: the reference makes no call here, and a forth word always does

\ ---- pix

: P_PIX_WRITE
    0 CLS
    10 10 4 PIX!
    10 10 PIX DROP
;

: P_PIX_READ
    2 CLS
    3 4 PIX DROP
;

\ pix/missing-y: the reference refuses the call and forth's stack cannot refuse one
\ pix/no-args: the reference refuses the call and forth's stack cannot refuse one
\ pix/float-coords: the argument is a string or a float, and forth's words take integers
\ pix/string-arg: the argument is a string or a float, and forth's words take integers

: P_PIX_OUT_OF_BOUNDS
    300 300 4 PIX!
    300 300 PIX DROP
;


